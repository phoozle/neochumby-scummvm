#!/bin/sh
# zig cc as rustc's linker for the Chumby (ARM926EJ-S, soft float, static
# musl): a copy of neochumby's tools/zigcc (MIT), for building this crate
# on its own (.cargo/config.toml); tools/tree uses neochumby's. rustc's musl
# targets link their own crt and libc unless told not to
# (link-self-contained=no); zig supplies them instead, and its libunwind
# for std's unwinder. Drops the arguments zig has no use for.
ZIG=${ZIG:-zig}
args=
for a in "$@"; do
  case "$a" in
    -lgcc_s) args="$args -lunwind" ;;
    -lgcc | --target=* | -Wl,--eh-frame-hdr | -Wl,-O1) ;;
    *) args="$args '$(printf %s "$a" | sed "s/'/'\\\\''/g")'" ;;
  esac
done
eval exec "$ZIG" cc -target arm-linux-musleabi -mcpu=arm926ej_s "$args"
