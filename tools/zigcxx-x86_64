#!/bin/sh
# zig c++ for neochumbyd's server (x86_64, static musl), for the converter
# built with --target x86_64-unknown-linux-musl (build.rs). Drops cc-rs's
# target flags, which zig has from here.
ZIG=${ZIG:-zig}
args=
for a in "$@"; do
  case "$a" in
    --target=* | -march=*) ;;
    *) args="$args '$(printf %s "$a" | sed "s/'/'\\\\''/g")'" ;;
  esac
done
eval exec "$ZIG" c++ -target x86_64-linux-musl "$args"
